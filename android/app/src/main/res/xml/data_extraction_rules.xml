<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer on Android 12+
     (android:dataExtractionRules). Only exclusions: everything else is backed
     up / transferred exactly as before. horsemd_sync_secure =
     HorseSecureStorePlugin.PREFS_FILE (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="horsemd_sync_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="horsemd_sync_secure.xml" />
    </device-transfer>
</data-extraction-rules>
